# Diese Datei wird von der API nicht selbst geladen; die Werte müssen als Umgebungsvariablen gesetzt werden (z. B. in Render oder in der Shell).

# WebApplication-Umgebung (IsProduction / IsDevelopment)
ASPNETCORE_ENVIRONMENT=CHANGE_ME

# Listen-Port, gelesen als PORT
PORT=CHANGE_ME

# PostgreSQL. DATABASE_URL hat Vorrang, wenn das Schema postgres oder postgresql ist.
DATABASE_URL=postgres://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/CHANGE_ME
ConnectionStrings__PostgresConnection=Host=CHANGE_ME;Port=5432;Database=CHANGE_ME;Username=CHANGE_ME;Password=CHANGE_ME

# SQL-Server-Fallback, nur wenn keine Postgres-Verbindung gesetzt ist
ConnectionStrings__DefaultConnection=CHANGE_ME

# Jwt:Key, Jwt:Issuer, Jwt:Audience
Jwt__Key=CHANGE_ME
Jwt__Issuer=CHANGE_ME
Jwt__Audience=CHANGE_ME

# Demo-Seed-Schalter. Der Code parst sie mit bool.Parse (true oder false).
# Fehlt der Wert, gilt false.
Seeding__DemoUsers__Enabled=CHANGE_ME
Seeding__DemoUsers__DefaultPassword=CHANGE_ME
Seeding__Locations__Enabled=CHANGE_ME
Seeding__Shifts__Enabled=CHANGE_ME
Seeding__UserLocationAssignments__Enabled=CHANGE_ME

# AdminSeed:Enabled, Email, Password. Enabled wird mit bool.TryParse gelesen.
AdminSeed__Enabled=CHANGE_ME
AdminSeed__Email=CHANGE_ME
AdminSeed__Password=CHANGE_ME
# Nur vorübergehend auf true setzen, um das Admin-Passwort zu rotieren, danach wieder auf false oder entfernen.
AdminSeed__ResetPasswordOnStart=false

# Cors:AllowedOrigins, Cors:AllowedOriginsCsv, Cors:AllowedOriginHostSuffixes
Cors__AllowedOrigins__0=CHANGE_ME
Cors__AllowedOriginsCsv=CHANGE_ME
Cors__AllowedOriginHostSuffixes__0=CHANGE_ME

# OpenApi:Enabled. Fehlt der Wert, gilt er in Development.
OpenApi__Enabled=CHANGE_ME

# UseHttpsRedirection. Fehlt der Wert, gilt er außerhalb von Development.
UseHttpsRedirection=CHANGE_ME
